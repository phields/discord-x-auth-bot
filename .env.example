# Wrangler 本地登录二选一：设置此 Token，或执行 `npx wrangler login`
CLOUDFLARE_API_TOKEN=

# Discord Developer Portal
DISCORD_APPID=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

# Discord 服务器资源 ID（同时要写入 wrangler.jsonc 的 vars）
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_VERIFIED=
DISCORD_UNVERIFIED=

# X Developer Console 的 OAuth 2.0 Client ID / Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev/oauth/x/callback
